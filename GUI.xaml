<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VM Migration Suite" Height="760" Width="980" MinHeight="640" MinWidth="860"
        WindowStartupLocation="CenterScreen" Background="#0A1428" FontFamily="Segoe UI" FontSize="13" Foreground="#E6F1FF">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#111F3A"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#1E3560"/>
        <SolidColorBrush x:Key="Accent" Color="#38D6FF"/>
        <SolidColorBrush x:Key="AccentDark" Color="#1E9BFF"/>
        <SolidColorBrush x:Key="Muted" Color="#8FA3C7"/>
        <SolidColorBrush x:Key="Text" Color="#E6F1FF"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,3"/></Style>
        <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1730"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/><Setter Property="Padding" Value="6,5"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#0B1730"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/><Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="6,5"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1B2E55"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/><Setter Property="Padding" Value="14,7"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#24407A"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentDark}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#7A2436"/>
        </Style>
        <Style x:Key="H1" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
        <Style x:Key="H2" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="Margin" Value="0,10,0,4"/></Style>
        <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/></Style>
        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#0F1D38" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="bd" Property="Background" Value="#14284D"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#152A50"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Name="imgLogo" Width="44" Height="44" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="VM MIGRATION SUITE" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    <TextBlock Name="lblStepTitle" Text="Passo 1 di 4 - Cosa vuoi fare?" Style="{StaticResource Hint}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Name="lblComputer" Text="" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    <TextBlock Name="lblLocalIp" Text="" HorizontalAlignment="Right" Style="{StaticResource Hint}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
            <Grid>
                <!-- STEP 1: modalita' -->
                <StackPanel Name="pnlMode" VerticalAlignment="Center" MaxWidth="640">
                    <TextBlock Text="Seleziona l'operazione da eseguire su questo PC" Style="{StaticResource H1}"/>
                    <RadioButton Name="rbExport" Style="{StaticResource ModeCard}" IsChecked="True">
                        <StackPanel><TextBlock Text="Esporta un profilo utente" FontWeight="SemiBold" FontSize="14"/><TextBlock Style="{StaticResource Hint}" Text="Crea un pacchetto di migrazione (dati, browser, Office, registro, Wi-Fi, stampanti, unita' di rete) su disco/USB o cartella di rete. Supporta anche dischi Windows non avviati (WinPE)."/></StackPanel>
                    </RadioButton>
                    <RadioButton Name="rbImport" Style="{StaticResource ModeCard}">
                        <StackPanel><TextBlock Text="Importa un pacchetto su questo PC" FontWeight="SemiBold" FontSize="14"/><TextBlock Style="{StaticResource Hint}" Text="Ripristina dati e impostazioni su un utente esistente o su un nuovo utente locale, con rimappatura del profilo e correzione dei permessi."/></StackPanel>
                    </RadioButton>
                    <RadioButton Name="rbReceive" Style="{StaticResource ModeCard}">
                        <StackPanel><TextBlock Text="Ricevi un pacchetto dalla rete (PC di destinazione)" FontWeight="SemiBold" FontSize="14"/><TextBlock Style="{StaticResource Hint}" Text="Mette questo PC in ascolto sulla LAN con un codice di accoppiamento. Al termine puoi importare subito."/></StackPanel>
                    </RadioButton>
                    <RadioButton Name="rbSend" Style="{StaticResource ModeCard}">
                        <StackPanel><TextBlock Text="Invia un pacchetto esistente via rete" FontWeight="SemiBold" FontSize="14"/><TextBlock Style="{StaticResource Hint}" Text="Trasferisce un pacchetto gia' creato a un PC in ascolto, con verifica SHA-256 e ripresa automatica."/></StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- STEP 2a: export -->
                <ScrollViewer Name="pnlExport" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Profilo da esportare" Style="{StaticResource H2}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox Name="cmbProfiles"/>
                                <Button Name="btnRefreshProfiles" Grid.Column="1" Content="Aggiorna" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Name="lblProfileInfo" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                            <CheckBox Name="chkOffline" Content="Disco Windows non avviato (WinPE / disco collegato come secondario)" Margin="0,8,0,0"/>
                            <Grid Name="pnlOffline" Visibility="Collapsed" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Radice disco:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Name="txtOfflineRoot" Grid.Column="1" Text="D:\"/>
                                <Button Name="btnOfflineBrowse" Grid.Column="2" Content="Sfoglia..." Margin="8,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Destinazione pacchetto (disco locale, USB o cartella di rete)" Style="{StaticResource H2}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Name="txtExportDest" Text="D:\Migrazioni"/>
                                <Button Name="btnExportBrowse" Grid.Column="1" Content="Sfoglia..." Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Name="lblFreeSpace" Style="{StaticResource Hint}" Margin="0,4,0,0"/>

                            <TextBlock Text="Impostazioni da includere" Style="{StaticResource H2}"/>
                            <StackPanel Name="pnlRegistrySets"/>
                            <CheckBox Name="chkSettings" IsChecked="True" Content="Wi-Fi (con password), stampanti, unita' di rete, sfondo, elenco applicazioni, product key"/>

                            <TextBlock Text="Cartelle aggiuntive (fuori dal profilo, es. D:\Lavoro)" Style="{StaticResource H2}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ListBox Name="lstExtra" Height="70" Background="#0B1730" Foreground="#E6F1FF" BorderBrush="#1E3560"/>
                                <Button Name="btnExtraAdd" Grid.Column="1" Content="+" Margin="8,0,0,0" VerticalAlignment="Top" Padding="12,6"/>
                                <Button Name="btnExtraRemove" Grid.Column="2" Content="-" Margin="4,0,0,0" VerticalAlignment="Top" Padding="12,6"/>
                            </Grid>

                            <TextBlock Text="Dopo l'esportazione" Style="{StaticResource H2}"/>
                            <CheckBox Name="chkSendAfter" Content="Invia subito il pacchetto a un PC in ascolto sulla rete"/>
                            <Grid Name="pnlSendAfter" Visibility="Collapsed" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="PC / IP:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Name="txtSendAfterHost" Grid.Column="1"/>
                                <TextBlock Text="Codice:" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,6,0"/>
                                <TextBox Name="txtSendAfterCode" Grid.Column="3" Width="80" MaxLength="6"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Dati da esportare" Style="{StaticResource H2}"/>
                                <Button Name="btnSelAll" Grid.Column="1" Content="Tutti" Padding="8,3" Margin="0,8,4,0"/>
                                <Button Name="btnSelDefault" Grid.Column="2" Content="Consigliati" Padding="8,3" Margin="0,8,0,0"/>
                            </Grid>
                            <StackPanel Name="pnlDataSets"/>
                            <Button Name="btnEstimate" Content="Calcola dimensione" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                            <TextBlock Name="lblEstimate" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- STEP 2b: import -->
                <ScrollViewer Name="pnlImport" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Pacchetto da importare" Style="{StaticResource H2}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Name="txtImportPkg"/>
                            <Button Name="btnImportBrowse" Grid.Column="1" Content="Sfoglia..." Margin="8,0,0,0"/>
                        </Grid>
                        <Border Background="#0B1730" BorderBrush="#1E3560" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,0">
                            <TextBlock Name="lblManifest" Style="{StaticResource Hint}" Text="Seleziona una cartella pacchetto (contiene manifest.json)."/>
                        </Border>

                        <TextBlock Text="Utente di destinazione su questo PC" Style="{StaticResource H2}"/>
                        <RadioButton Name="rbTargetExisting" Content="Utente esistente:" IsChecked="True"/>
                        <Grid Margin="22,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox Name="cmbTargetUsers" IsEditable="True"/>
                            <Button Name="btnRefreshUsers" Grid.Column="1" Content="Aggiorna" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,0" Text="Per un account di dominio o Microsoft/Entra ID che non ha ancora eseguito l'accesso, scrivi DOMINIO\utente oppure AzureAD\nome.cognome@azienda.it: il profilo verra' creato."/>
                        <RadioButton Name="rbTargetNew" Content="Crea nuovo utente locale:" Margin="0,8,0,0"/>
                        <Grid Name="pnlNewUser" Margin="22,4,0,0" IsEnabled="False">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="Nome:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Name="txtNewUser" Grid.Column="1" Margin="0,0,0,4"/>
                            <TextBlock Text="Password:" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,8,4"/>
                            <PasswordBox Name="pwdNewUser" Grid.Column="3" Margin="0,0,0,4"/>
                            <TextBlock Text="Nome completo:" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Name="txtNewFullName" Grid.Row="1" Grid.Column="1"/>
                            <CheckBox Name="chkNewAdmin" Grid.Row="1" Grid.Column="3" Content="Amministratore" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="Cosa ripristinare" Style="{StaticResource H2}"/>
                        <StackPanel Name="pnlImportSets"/>
                        <CheckBox Name="chkImpRegistry" IsChecked="True" Content="Registro utente (desktop, Esplora file, Office, app) con rimappatura SID/percorso"/>
                        <CheckBox Name="chkImpWifi" IsChecked="True" Content="Profili Wi-Fi"/>
                        <CheckBox Name="chkImpPrinters" IsChecked="True" Content="Stampanti di rete / IP e predefinita"/>
                        <CheckBox Name="chkImpDrives" IsChecked="True" Content="Unita' di rete mappate"/>
                        <CheckBox Name="chkImpWallpaper" IsChecked="True" Content="Sfondo del desktop"/>
                        <CheckBox Name="chkImpSkipNewer" IsChecked="True" Content="Non sovrascrivere file piu' recenti gia' presenti a destinazione"/>
                        <CheckBox Name="chkImpAcl" IsChecked="True" Content="Correggi proprietario e permessi NTFS"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- STEP 2c: receive -->
                <StackPanel Name="pnlReceive" Visibility="Collapsed" MaxWidth="700" HorizontalAlignment="Left">
                    <TextBlock Text="Dove salvare il pacchetto ricevuto" Style="{StaticResource H2}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Name="txtRecvDest" Text="C:\Migrazioni"/>
                        <Button Name="btnRecvBrowse" Grid.Column="1" Content="Sfoglia..." Margin="8,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Porta TCP:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Name="txtRecvPort" Text="8888"/>
                    </Grid>
                    <Border Background="#0B1730" BorderBrush="#38D6FF" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Codice di accoppiamento da inserire sul PC che invia:" Style="{StaticResource Hint}"/>
                            <TextBlock Name="lblPairCode" Text="------" FontSize="40" FontWeight="Bold" Foreground="#38D6FF" Margin="0,4"/>
                            <TextBlock Name="lblRecvIps" Style="{StaticResource Hint}"/>
                            <Button Name="btnNewCode" Content="Genera nuovo codice" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <CheckBox Name="chkImportAfterRecv" IsChecked="True" Content="Al termine passa direttamente all'importazione" Margin="0,12,0,0"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="Le regole del firewall di Windows vengono create automaticamente all'avvio dell'ascolto e rimosse al termine."/>
                </StackPanel>

                <!-- STEP 2d: send -->
                <StackPanel Name="pnlSend" Visibility="Collapsed" MaxWidth="700" HorizontalAlignment="Left">
                    <TextBlock Text="Pacchetto da inviare" Style="{StaticResource H2}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Name="txtSendPkg"/>
                        <Button Name="btnSendBrowse" Grid.Column="1" Content="Sfoglia..." Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="PC di destinazione" Style="{StaticResource H2}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox Name="cmbSendHost" IsEditable="True"/>
                        <Button Name="btnScan" Grid.Column="1" Content="Cerca in rete" Margin="8,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Porta TCP:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Name="txtSendPort" Text="8888"/>
                        <TextBlock Text="Codice:" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <TextBox Name="txtSendCode" Grid.Column="3" MaxLength="6" FontSize="16" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>

                <!-- STEP 3: esecuzione -->
                <Grid Name="pnlRun" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Name="lblRunTitle" Text="Pronto." FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Name="btnCancel" Grid.Column="1" Content="Annulla" Style="{StaticResource Danger}" IsEnabled="False"/>
                    </Grid>
                    <TextBox Name="txtLog" Grid.Row="1" IsReadOnly="True" Background="#060D1C" Foreground="#9FE8FF" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" Padding="8"/>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Name="lblRunStatus" Text="" Style="{StaticResource Hint}"/>
                        <TextBlock Name="lblRunSpeed" Grid.Column="1" Text="" Style="{StaticResource Hint}"/>
                    </Grid>
                    <ProgressBar Name="progressBar" Grid.Row="3" Height="16" Margin="0,6,0,0" Minimum="0" Maximum="100" Foreground="#38D6FF" Background="#0B1730" BorderBrush="#1E3560"/>
                </Grid>

                <!-- STEP 4: riepilogo -->
                <StackPanel Name="pnlDone" Visibility="Collapsed" VerticalAlignment="Center" MaxWidth="700">
                    <TextBlock Name="lblDoneTitle" Text="Operazione completata" Style="{StaticResource H1}"/>
                    <TextBlock Name="lblDoneText" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <WrapPanel>
                        <Button Name="btnOpenPkg" Content="Apri cartella pacchetto" Margin="0,0,8,8"/>
                        <Button Name="btnOpenLog" Content="Apri log" Margin="0,0,8,8"/>
                        <Button Name="btnImportNow" Content="Importa ora questo pacchetto" Style="{StaticResource Primary}" Margin="0,0,8,8" Visibility="Collapsed"/>
                        <Button Name="btnRestart" Content="Nuova operazione" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="Nota: le password salvate nei browser e in Outlook non sono migrabili (cifratura DPAPI legata al vecchio utente); i programmi vanno reinstallati (vedi Settings\apps.csv o winget.json nel pacchetto)."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Name="btnBack" Content="Indietro" IsEnabled="False"/>
            <TextBlock Name="lblFooter" Grid.Column="1" Text="vm technology - VM Migration Suite v3.0.2" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0"/>
            <Button Name="btnNext" Grid.Column="2" Content="Avanti" Style="{StaticResource Primary}" Padding="24,8"/>
        </Grid>
    </Grid>
</Window>
